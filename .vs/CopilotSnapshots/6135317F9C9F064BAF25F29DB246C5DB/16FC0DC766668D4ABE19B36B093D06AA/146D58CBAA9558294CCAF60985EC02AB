            }
        }
        private void LoadTipFromFile(string filepath)
        {
            try
            {
                string[] lines = File.ReadAllLines(filepath);

                for (int i = 0; i < lines.Length; i += 5)
                {
                    try
                    {
                        if (i + 3 >= lines.Length) break;

                        string fullName = lines[i].Trim();

                        string dobLine = lines[i + 1].Trim();
                        string addressLine1 = lines[i + 2].Trim();
                        string addressLine2 = lines[i + 3].Trim();

                        if (DateTime.TryParseExact(dobLine, "dd/MM/yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime dob))
                        {
                            string[] nameParts = fullName.Split(new char[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                            string firstName = nameParts.Length > 1 ? nameParts[nameParts.Length - 2] : nameParts[0];
                            string lastName = nameParts.Length > 1 ? nameParts[nameParts.Length - 1] : "";

                            string fullAddress = $"{addressLine1}, {addressLine2}";

                            var account = new SkybetAccountTip
                            {
                                Fullname = fullName,
                                Firstname = firstName,
                                Lastname = lastName,
                                Birthday = dob,
                                Address = fullAddress
                            };
                            m_skybetList.Add(account);
                        }
                    }
                    catch { }
                }
                onWriteStatus(string.Format("Load {0} Account..", m_skybetList.Count));
            }
            catch { }
        }
        private bool IsDuplicateInDatabase(SkybetAccountTip account)
        {
            try
            {
                string m_connectionString = "Data Source=AccountResult.db;Version=3;";
                using (var conn = new SQLiteConnection(m_connectionString))
                {
                    conn.Open();

                    string query = @"
                    SELECT COUNT(*) FROM tb_Skybet
                    WHERE LOWER(Fullname) = @Fullname
                    AND LOWER(Address) = @Address
                    AND Birthday = @Birthday";
                    using (var cmd = new SQLiteCommand(query, conn))
                    {
                        cmd.Parameters.AddWithValue("@Fullname", account.Fullname.ToLower());
                        cmd.Parameters.AddWithValue("@Address", account.Address.ToLower());
                        cmd.Parameters.AddWithValue("@Birthday", account.Birthday.ToString("yyyy-MM-dd 00:00:00")); // Match format used in DB

                        long count = (long)cmd.ExecuteScalar();
                        return count > 0;
                    }
                }
            }
            catch (Exception ex)
            {
                onWriteStatus("Database check error: " + ex.Message);
                return false;
            }
        }

