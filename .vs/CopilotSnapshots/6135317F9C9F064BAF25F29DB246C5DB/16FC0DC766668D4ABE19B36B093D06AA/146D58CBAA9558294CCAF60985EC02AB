        private async void btn_ui_create_Click(object sender, EventArgs e)
        {
            GetSettingFromUI();
            SetSettingToFile();
            try
            {
                m_skybetCtr = new SkybetCtr(onWriteStatus, onWriteLog, m_skyproxyinfo);

                LoadTipFromFile(ui_filepath.Text);
                foreach (SkybetAccountTip accountTip in m_skybetList)
                {
                    try
                    {
                        accountTip.Phone = "07" + GenerateRandomPhone(_rand);
                        accountTip.Email = accountTip.Firstname + "." + accountTip.Lastname + "@gamil.com";
                        accountTip.Mothername = "Jemilah";
                        accountTip.Answer = "monkey";
                        accountTip.LoginPIN = m_skyproxyinfo.LoginPIN;
                        string first3Word1 = accountTip.Firstname.Substring(0, 3);
                        string first3Word2 = accountTip.Lastname.Substring(0, 3);
                        accountTip.Username = first3Word1 + first3Word2 + GenerateUsername(_rand);
                        accountTip.ProxyURL = m_skyproxyinfo.ProxyURL;
                        accountTip.ProxyUser = m_skyproxyinfo.ProxyUser;
                        accountTip.ProxyPass = m_skyproxyinfo.ProxyPass;
                    }
                    catch { }
                }

                onWriteStatus("Checking duplicate tips...");
                for (int i = m_skybetList.Count - 1; i >= 0; i--)
                {
                    var accountTip = m_skybetList[i];
                    try
                    {
                        if (IsDuplicateInDatabase(accountTip))
                        {
                            onWriteStatus($"Duplicate found in DB: {accountTip.Firstname} {accountTip.Lastname} ({accountTip.Birthday:yyyy-MM-dd})");
                            m_skybetList.RemoveAt(i);
                        }
                    }
                    catch { }
                }
                
                onWriteStatus("**********************************************");
                onWriteStatus(string.Format("Get {0} New Accout", m_skybetList.Count));
                if (m_skybetList.Count == 0)
                {
                    onWriteStatus("Bot Stop");
                    return;
                }
                onWriteStatus("Create Acccount Start");

                await Task.Run(async () =>
                {
                    foreach (SkybetAccountTip accountTip in m_skybetList)
                    {
                        try
                        {
                            bool bresult = false;
                            bresult = await m_skybetCtr.CreateAccount(accountTip);
                            m_skybetCtr._chromeDevCtr.Close_Browser();
                        }
                        catch { }
                    }
                });

                onWriteStatus("Finish Working");
                onWriteStatus("**********************************************");
            }
            catch { }
        }
        public static string GenerateUsername(Random _rand)
        {
            const string Letters = "abcdefghijklmnopqrstuvwxyz";
            var sb = new StringBuilder(11);

            for (int i = 0; i < 3; i++)
                sb.Append(Letters[_rand.Next(Letters.Length)]);
            return sb.ToString();
        }
        public string GenerateRandomPhone(Random _rand)
        {
            var sb = new StringBuilder(10);
            for (int i = 0; i < 9; i++)
                sb.Append(_rand.Next(10));
            return sb.ToString();
        }
        public string GenerateRandomPassword(Random _rand)
        {
            var sb = new StringBuilder(10);
            for (int i = 0; i < 6; i++)
                sb.Append(_rand.Next(10));
            return sb.ToString();
        }
