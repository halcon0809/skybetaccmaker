        #region Log
        private void writeStatus(string status)
        {
            try
            {
                string curPath = Directory.GetCurrentDirectory();
                bool exists = System.IO.Directory.Exists(curPath + "\\Log");
                if (!exists)
                    System.IO.Directory.CreateDirectory(curPath + "\\Log");
                if (ui_log.InvokeRequired)
                    ui_log.Invoke(onWriteStatus, status);
                else
                {
                    string logText = ((string.IsNullOrEmpty(ui_log.Text) ? "" : "\r") + string.Format("[{0}] {1}", DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"), status));
                    if (prevMessage.Equals(status)) return;
                    this.onWriteLog(curPath + "\\Log\\" + string.Format("log_{0}.txt", DateTime.Now.ToString("yyyy-MM-dd")), logText);
                    ui_log.AppendText(logText);
                    ui_log.ScrollToCaret();
                    prevMessage = logText;
                }
            }
            catch (Exception)
            {
            }
        }
        private void LogToFile(string filename, string result)
        {
            try
            {
                string curPath = Directory.GetCurrentDirectory();
                if (string.IsNullOrEmpty(filename))
                    return;
                StreamWriter streamWriter = new StreamWriter((Stream)System.IO.File.Open(filename, FileMode.Append, FileAccess.Write, FileShare.Read), Encoding.UTF8);
                if (!string.IsNullOrEmpty(result))
                    streamWriter.WriteLine(result);
                streamWriter.Close();
            }
            catch (System.Exception ex)
            {
                onWriteStatus("LogToFile Error => " + ex.Message);
            }
        }
